# Optional proxy for requests made from inside the container.
# Docker Desktop exposes the host as host.docker.internal.
# Leave blank when the container can reach the market data endpoints directly.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Host port and timezone for docker-compose.
# This is the port published on the HOST. Inside the container the workbench
# is pinned to 8765 by the Dockerfile (WORKBENCH_PORT=8765), so only change
# this value if 8765 is taken on your machine.
DASHBOARD_PORT=8765
TZ=Asia/Shanghai
